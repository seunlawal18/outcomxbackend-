PORT=
NODE_ENV=
JWT_SECRET=
JWT_EXPIRES_IN=
ALLOWED_ORIGINS=
DB_PATH=
BCRYPT_ROUNDS=
DATABASE_URL=

# Email — Resend
RESEND_API_KEY=
FROM_EMAIL=
APP_NAME=

# Crypto deposits — see scripts/generate-treasury-wallet.ts for TREASURY_XPUB.
# ALCHEMY_NETWORK defaults to polygon-amoy (testnet) if unset; set to
# polygon-mainnet when going live. ALCHEMY_WEBHOOK_SIGNING_KEY comes from
# Alchemy's dashboard when you create the Address Activity webhook.
ALCHEMY_API_KEY=
ALCHEMY_NETWORK=
TREASURY_XPUB=
ALCHEMY_WEBHOOK_SIGNING_KEY=

# Account-level Notify API credentials — lets the server auto-register each
# new deposit address with the webhook. ALCHEMY_AUTH_TOKEN comes from the
# dashboard's Notify page ("View Auth Token"); ALCHEMY_WEBHOOK_ID identifies
# which webhook to update (see scripts/find-webhook-id.ts). Both optional —
# unset just means new addresses rely on reconcileDeposits() instead of an
# instant push.
ALCHEMY_AUTH_TOKEN=
ALCHEMY_WEBHOOK_ID=
